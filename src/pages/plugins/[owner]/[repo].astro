---
// One page per plugin, at /plugins/<owner>/<repo>/: every plugin the catalog lists, and every one with a page
// written by hand (src/lib/written.mjs). A plugin is its repository (catalog schema 5), so that names the page. A
// written page is its file; any other is generated from its catalog row. The releases and the icon come from the
// catalog, so they show only when it reads.
import Site from '../../../layouts/Site.astro';
import Figure from '../../../components/Figure.astro';
import { RANK_LABEL, loadCatalog, withFiles } from '../../../lib/catalog.mjs';
import { WRITTEN } from '../../../lib/written.mjs';
import { letterOf } from '../../../scripts/gallery.mjs';

export async function getStaticPaths() {
  const catalog = await withFiles(await loadCatalog());
  const listed = catalog.ok ? catalog.plugins : [];
  const repos = new Set([...WRITTEN.keys(), ...listed.map((plugin) => plugin.repo)]);
  return [...repos].map((repo) => {
    const [owner, name] = repo.split('/');
    return {
      params: { owner, repo: name },
      props: { plugin: listed.find((p) => p.repo === repo), written: WRITTEN.get(repo) },
    };
  });
}

const { plugin, written } = Astro.props;
const front = written?.frontmatter;
const Content = written?.Content;
const name = front?.name ?? plugin.name;
const repo = plugin?.repo ?? front.repo;
const lede = front?.summary ?? plugin.description;
const features = front?.features ?? [];
---

<Site title={name} description={lede || `${name}, a BotMaker plugin.`}>
  <section class="first">
    <div class="wrap">
      <p class="eyebrow"><a href="/plugins/">Plugins</a> / {name}</p>
      <div class="phead">
        <span class="gicon" aria-hidden="true">{letterOf(name)}{plugin?.icon && <img src={plugin.icon} alt="" width="44" height="44" />}</span>
        <h1>{front ? <>{front.headline}<br /><em>{front.emphasis}</em></> : name}</h1>
      </div>
      {lede && <p class="lede">{lede}</p>}
      <div class="ctas">
        <a class="btn" href={`https://github.com/${repo}`}>Repository</a>
        <span class="note">
          {plugin ? `${RANK_LABEL[plugin.rank]} plugin · ${plugin.newest.tag} · ` : ''}add it in a project's Plugins &amp; Libraries
        </span>
      </div>
      {Content && <div class="prose"><Content /></div>}
      {features.length > 0 && (
        <div class="feat">
          {features.map((feature, i) => (
            <div>
              <Figure n={i + 1} caption={feature.title} alt={feature.alt} src={feature.src} srcDark={feature.srcDark} />
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  {plugin && (
    <section class="last">
      <div class="wrap">
        <p class="eyebrow">From the catalog</p>
        <h2>Releases</h2>
        <p class="note">Newest first. Each release is pinned to the commit it was built from.</p>
        <ol class="releases">
          {plugin.releases.map((release) => (
            <li><span class="tag">{release.tag}</span> <code>{release.commit.slice(0, 7)}</code></li>
          ))}
        </ol>
      </div>
    </section>
  )}
</Site>
