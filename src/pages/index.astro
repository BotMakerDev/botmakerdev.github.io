---
import Site from '../layouts/Site.astro';
---

<Site description="BotMaker Studio is a Scratch-like Java IDE: snap blocks together and get real Java, with no ceiling when you outgrow the blocks.">
  <section class="first">
    <div class="wrap">
      <p class="eyebrow">A visual Java IDE</p>
      <h1>Snap blocks together.<br /><em>Get real Java.</em></h1>
      <p class="lede">
        Like Scratch, for anyone — but every block is Java you own. When the blocks run out, you keep going in code.
      </p>
      <div class="ctas">
        <a class="btn primary" href="/install/">Download Studio</a>
        <a class="btn" href="/docs/">Your first program</a>
      </div>
    </div>
  </section>
</Site>
